{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus-edge-installer-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "installer.francisconeto.net.br",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "nexus-edge-releases-staging",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INSTALLATION_SESSION",
        "class_name": "InstallationSession",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InstallationSession"],
    },
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "INSTALLER_ORIGIN": "https://installer.francisconeto.net.br",
    "OAUTH_CLIENT_ID": "742459137762a85c561a53db69d1d515",
    "OAUTH_REDIRECT_URI": "https://installer.francisconeto.net.br/oauth/callback",
    "OAUTH_SCOPES": "account-settings.read d1.write queues.write workers-scripts.write workers-routes.write zone.read",
    "RELEASE_CHANNEL": "stable",
    "RELEASE_PUBLIC_KEY": "MCowBQYDK2VwAyEA1OKQdSIG/k/H12TF+3Z66x9192pbTbbpTRWlJBOwXl8=",
    "RELEASE_PUBLIC_KEY_NEXT": "MCowBQYDK2VwAyEAV4gfQre2L/V47J5LeCeUbFY6GYkW3PHJNABtsoHuvIU=",
    "INSTALLER_VERSION": "1.0.0",
    "SESSION_TTL_SECONDS": "3600",
    "METADATA_TTL_SECONDS": "86400",
  },
  "secrets": {
    "required": ["OAUTH_CLIENT_SECRET", "SESSION_ENCRYPTION_KEY"],
  },
  "observability": {
    "enabled": false,
  },
}
