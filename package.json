{
  "name": "nexus-edge-installer",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:frontend && pnpm --filter @app/installer-worker build",
    "build:frontend": "pnpm --filter @app/installer-frontend build",
    "cf-typegen": "pnpm --filter @app/installer-worker cf-typegen",
    "deploy": "pnpm build:frontend && pnpm --filter @app/installer-worker deploy",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm test:runtime",
    "test:runtime": "pnpm --dir worker exec vitest run --config vitest.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p worker/tests/tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@app/installer-release-schema": "workspace:*",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
